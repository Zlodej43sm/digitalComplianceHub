{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "digital-compliance-hub-local",
  "main": "src/adapters/cloudflare/worker.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "env": {
    "dev": {
      "name": "digital-compliance-hub-dev",
      "workers_dev": false,
      "preview_urls": false,
    },
    "demo": {
      "name": "digital-compliance-hub-demo",
      "workers_dev": false,
      "preview_urls": false,
    },
  },
}
